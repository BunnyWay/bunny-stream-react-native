# Copy to .env in this directory. The .env file is ignored by Git.
# Use apple_id when you cannot create an App Store Connect API key.
TESTFLIGHT_AUTH=apple_id
FASTLANE_USER=
# Generate at https://account.apple.com > Sign-In and Security > App-Specific Passwords.
# This is an app-specific password, not your regular Apple Account password.
FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=
# Numeric Apple ID from App Store Connect > My Apps > App Information.
APP_STORE_CONNECT_APPLE_ID=
# Optional: override the App Store Connect team for this checkout.
# FASTLANE_ITC_TEAM_ID=
# Optional: provider public ID for accounts with multiple providers on Xcode 26+.
# APP_STORE_CONNECT_PROVIDER_PUBLIC_ID=

# Alternative: set TESTFLIGHT_AUTH=api_key and fill in these three values.
# App Store Connect > Users and Access > Integrations > App Store Connect API.
# Use an App Manager or Admin team API key to manage external builds and release notes.
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_ISSUER_ID=
# Store the downloaded .p8 file outside the repository; use an absolute path.
APP_STORE_CONNECT_API_KEY_FILE=

# Optional: choose an IPA for yarn example:upload:ios (relative to example/ or absolute).
# TESTFLIGHT_IPA_PATH=ios/build/ipa/ReactTestApp.ipa

# An existing external tester. Fastlane finds their external group for this app.
# TESTFLIGHT_TESTER_EMAIL=tester@example.com
# Set the group name or ID if the tester belongs to several external groups for this app.
# TESTFLIGHT_GROUP=External Testers
# Apple ID mode can reuse an App Store Connect web session generated by `fastlane spaceauth`.
# FASTLANE_SESSION=

# Match the confirmed export compliance declaration for the iOS example app.
# PILOT_USES_NON_EXEMPT_ENCRYPTION=false
# Set only if App Store Connect provides an encryption export compliance code.
# IOS_ENCRYPTION_EXPORT_COMPLIANCE_CODE=

# Optional Firebase overrides (or use example/firebase-distribution.json).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
# FIREBASE_APP_ID=
# FIREBASE_GROUPS=internal-testers
# FIREBASE_TESTERS=tester@example.com
# FIREBASE_RELEASE_NOTES=
