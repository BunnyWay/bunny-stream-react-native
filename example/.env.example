# Optional — required only for library management, uploads, and broadcasting.
# Leave empty for playback-only mode (public videos and live streams).
BUNNY_ACCESS_KEY=your-bunny-stream-access-key
# Optional — the "Token authentication key" from the library's Security page.
# A different value from the API key; signs embed-view/playback tokens when
# embed view or CDN token authentication is enabled. Defaults to BUNNY_ACCESS_KEY.
BUNNY_TOKEN_AUTH_KEY=your-token-authentication-key
BUNNY_LIBRARY_ID=your-library-id
# Comma-separated list of default video IDs
BUNNY_VIDEO_IDS=your-default-video-id-1,your-default-video-id-2
# Comma-separated list of default live stream IDs
BUNNY_STREAM_IDS=your-default-stream-id-1,your-default-stream-id-2
