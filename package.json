{
  "name": "@bunny.net/stream-react-native",
  "version": "0.1.0",
  "description": "Bunny Stream React Native SDK - native bridge for Bunny Stream, wrapping the official iOS and Android SDKs.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "bunny-stream-react-native-source": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      },
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "app.plugin.js",
    "plugin/build",
    "react-native.config.js",
    "native-sdk-baselines.json",
    "docs/CAPABILITIES.md",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!android/src/test",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace bunny-stream-react-native-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib plugin/build",
    "prepare": "bob build && yarn plugin:build",
    "plugin:build": "tsc -p plugin/tsconfig.json",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "release": "release-it --only-version",
    "fallow": "fallow health --report-only",
    "capabilities:generate": "node scripts/generate-capabilities.mjs",
    "capabilities:check": "node scripts/generate-capabilities.mjs --check",
    "native-baselines:check": "node scripts/verify-native-sdk-baselines.mjs",
    "native-android:publish": "node scripts/publish-android-sdk.mjs",
    "codegen": "react-native codegen --source library --path . --platform all --outputPath example/build/generated/codegen",
    "example:start": "yarn example start",
    "example:ios": "yarn example ios",
    "example:android": "yarn example android",
    "example:typecheck": "yarn example typecheck",
    "example:expo": "yarn workspace bunny-stream-react-native-example-expo"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "bunny",
    "bunny-stream",
    "video",
    "streaming",
    "cdn",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BunnyWay/bunny-stream-react-native.git"
  },
  "bugs": {
    "url": "https://github.com/BunnyWay/bunny-stream-react-native/issues"
  },
  "homepage": "https://github.com/BunnyWay/bunny-stream-react-native#readme",
  "author": "Bunny <support@bunny.net> (https://bunny.net)",
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "yarn": ">=4.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.39.0",
    "@jest/globals": "^29.7.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@release-it/conventional-changelog": "^11.0.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "^19.2.0",
    "commitlint": "^21.0.2",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-perfectionist": "^5.9.0",
    "fallow": "^2.87.0",
    "globals": "^17.6.0",
    "jest": "^29.7.0",
    "lefthook": "^2.1.9",
    "prettier": "^3.8.3",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.0",
    "release-it": "^20.2.0",
    "test-renderer": "1.2",
    "turbo": "^2.9.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1"
  },
  "peerDependencies": {
    "expo": ">=52.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.71.0"
  },
  "workspaces": [
    "example",
    "example-expo"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "BunnyStreamReactNativeSpec",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "net.bunny.reactnative",
      "modules": [
        "BunnyStreamApi"
      ]
    },
    "ios": {
      "modules": {
        "BunnyStreamPlayer": {
          "className": "BunnyStreamPlayerModule"
        },
        "BunnyStreamApi": {
          "className": "BunnyStreamApiModule"
        },
        "BunnyStreamUpload": {
          "className": "BunnyStreamUploadModule"
        }
      },
      "components": {
        "BunnyStreamPlayerView": {
          "className": "BunnyStreamPlayerView"
        },
        "BunnyLiveStreamPlayerView": {
          "className": "BunnyLiveStreamPlayerView"
        },
        "BunnyStreamBroadcasterView": {
          "className": "BunnyStreamBroadcasterView"
        }
      }
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "bunny-stream-react-native-source"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/example-expo/node_modules",
      "<rootDir>/lib/"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/lib/",
      "<rootDir>/src/__tests__/helpers.tsx"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "header-max-length": [
        2,
        "always",
        150
      ]
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.63.0"
  },
  "dependencies": {
    "@expo/config-plugins": ">=9.0.0 <60.0.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  }
}
