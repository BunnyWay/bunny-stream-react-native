# Copy to .env and fill in your Bunny Stream credentials.
# EXPO_PUBLIC_* variables are inlined into the JS bundle by Expo.
EXPO_PUBLIC_BUNNY_ACCESS_KEY=
EXPO_PUBLIC_BUNNY_LIBRARY_ID=
# Optional: token security key for libraries with token authentication enabled.
# Demo only — never embed this in a production app (sign tokens server-side).
EXPO_PUBLIC_BUNNY_TOKEN_AUTH_KEY=
