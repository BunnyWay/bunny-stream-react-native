<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!--
    Dark AppCompat theme for the native VOD player. The bridge wraps the host
    Activity context with this theme so that the SDK's BunnyPlayerView and
    its controls (including the androidx.appcompat.widget.PopupMenu opened by
    the settings gear) use light text on dark backgrounds. AppCompat is the
    correct parent because the SDK uses androidx.appcompat.widget.PopupMenu,
    which ignores the platform Theme_Material popup styling in some cases.
  -->
  <style name="BunnyReactNativePlayerTheme" parent="Theme.AppCompat.NoActionBar">
    <item name="android:textColor">@android:color/white</item>
    <item name="android:colorBackground">@android:color/black</item>
    <item name="android:windowBackground">@android:color/black</item>
  </style>
</resources>
